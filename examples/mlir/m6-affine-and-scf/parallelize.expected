module {
  func.func @matmul(%arg0: memref<4x3xf32>, %arg1: memref<3x2xf32>, %arg2: memref<4x2xf32>) {
    affine.parallel (%arg3) = (0) to (4) {
      affine.parallel (%arg4) = (0) to (2) {
        affine.for %arg5 = 0 to 3 {
          %0 = affine.load %arg0[%arg3, %arg5] : memref<4x3xf32>
          %1 = affine.load %arg1[%arg5, %arg4] : memref<3x2xf32>
          %2 = affine.load %arg2[%arg3, %arg4] : memref<4x2xf32>
          %3 = arith.mulf %0, %1 : f32
          %4 = arith.addf %2, %3 : f32
          affine.store %4, %arg2[%arg3, %arg4] : memref<4x2xf32>
        }
      }
    }
    return
  }
  func.func @total(%arg0: memref<8xf32>) -> f32 {
    %cst = arith.constant 0.000000e+00 : f32
    %0 = affine.parallel (%arg1) = (0) to (8) reduce ("addf") -> (f32) {
      %2 = affine.load %arg0[%arg1] : memref<8xf32>
      affine.yield %2 : f32
    }
    %1 = arith.addf %cst, %0 : f32
    return %1 : f32
  }
}

