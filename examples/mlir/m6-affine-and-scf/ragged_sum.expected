module {
  func.func @ragged_sum(%arg0: memref<4x8xf32>, %arg1: memref<4xindex>) -> f32 {
    %cst = arith.constant 0.000000e+00 : f32
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %0 = scf.for %arg2 = %c0 to %c4 step %c1 iter_args(%arg3 = %cst) -> (f32) {
      %1 = memref.load %arg1[%arg2] : memref<4xindex>
      %2 = scf.for %arg4 = %c0 to %1 step %c1 iter_args(%arg5 = %cst) -> (f32) {
        %4 = memref.load %arg0[%arg2, %arg4] : memref<4x8xf32>
        %5 = arith.addf %arg5, %4 : f32
        scf.yield %5 : f32
      }
      %3 = arith.addf %arg3, %2 : f32
      scf.yield %3 : f32
    }
    return %0 : f32
  }
}

