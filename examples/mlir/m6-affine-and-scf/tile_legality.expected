module {
  func.func @spread(%arg0: memref<5x8xf32>) {
    affine.for %arg1 = 1 to 5 {
      affine.for %arg2 = 0 to 4 {
        %0 = affine.load %arg0[%arg1 - 1, %arg2 * 2 + 1] : memref<5x8xf32>
        affine.store %0, %arg0[%arg1, %arg2] : memref<5x8xf32>
      }
    }
    return
  }
}


// -----
#map = affine_map<(d0) -> (d0)>
#map1 = affine_map<(d0) -> (d0 + 2)>
module {
  func.func @skew(%arg0: memref<5x5xf32>) {
    %cst = arith.constant 1.000000e+00 : f32
    affine.for %arg1 = 1 to 5 step 2 {
      affine.for %arg2 = 0 to 4 step 2 {
        affine.for %arg3 = #map(%arg1) to #map1(%arg1) {
          affine.for %arg4 = #map(%arg2) to #map1(%arg2) {
            %0 = affine.load %arg0[%arg3 - 1, %arg4 + 1] : memref<5x5xf32>
            %1 = arith.addf %0, %cst : f32
            affine.store %1, %arg0[%arg3, %arg4] : memref<5x5xf32>
          }
        }
      }
    }
    return
  }
}

