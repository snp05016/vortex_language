module {
  func.func @dot(%arg0: memref<8xf32>, %arg1: memref<8xf32>) -> f32 {
    %0 = llvm.mlir.constant(0 : index) : i64
    %1 = builtin.unrealized_conversion_cast %0 : i64 to index
    %2 = llvm.mlir.constant(1 : index) : i64
    %3 = builtin.unrealized_conversion_cast %2 : i64 to index
    %4 = llvm.mlir.constant(8 : index) : i64
    %5 = builtin.unrealized_conversion_cast %4 : i64 to index
    %6 = llvm.mlir.constant(0.000000e+00 : f32) : f32
    %7 = scf.for %arg2 = %1 to %5 step %3 iter_args(%arg3 = %6) -> (f32) {
      %8 = memref.load %arg0[%arg2] : memref<8xf32>
      %9 = memref.load %arg1[%arg2] : memref<8xf32>
      %10 = llvm.fmul %8, %9  : f32
      %11 = llvm.fadd %arg3, %10  : f32
      scf.yield %11 : f32
    }
    return %7 : f32
  }
}

