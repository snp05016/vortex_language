module {
  func.func @float_identities(%arg0: f32) -> (f32, f32, f32, f32, f32) {
    %cst = arith.constant 0.000000e+00 : f32
    %0 = arith.addf %arg0, %cst : f32
    %1 = arith.mulf %arg0, %cst : f32
    %2 = arith.subf %arg0, %arg0 : f32
    return %0, %arg0, %arg0, %1, %2 : f32, f32, f32, f32, f32
  }
}

