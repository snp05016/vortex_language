module {
  func.func @repaired(%arg0: i1, %arg1: f32) -> f32 {
    cf.cond_br %arg0, ^bb1, ^bb2(%arg1 : f32)
  ^bb1:  // pred: ^bb0
    %0 = arith.addf %arg1, %arg1 : f32
    cf.br ^bb2(%0 : f32)
  ^bb2(%1: f32):  // 2 preds: ^bb0, ^bb1
    %2 = arith.mulf %1, %arg1 : f32
    return %2 : f32
  }
}

