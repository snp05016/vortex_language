module {
  func.func @fetch_add(%arg0: memref<8xf32, strided<[?], offset: ?>>, %arg1: index, %arg2: f32) -> (memref<8xf32, strided<[?], offset: ?>>, f32) {
    %0 = memref.load %arg0[%arg1] : memref<8xf32, strided<[?], offset: ?>>
    %1 = arith.addf %0, %arg2 : f32
    memref.store %1, %arg0[%arg1] : memref<8xf32, strided<[?], offset: ?>>
    return %arg0, %0 : memref<8xf32, strided<[?], offset: ?>>, f32
  }
}

