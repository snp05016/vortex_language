#map = affine_map<(d0) -> (d0)>
module {
  func.func @scale(%arg0: memref<4xf32>, %arg1: f32) -> memref<4xf32> {
    %alloc = memref.alloc() {alignment = 64 : i64} : memref<4xf32>
    linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel"]} ins(%arg0 : memref<4xf32>) outs(%alloc : memref<4xf32>) {
    ^bb0(%in: f32, %out: f32):
      %0 = arith.mulf %in, %arg1 : f32
      linalg.yield %0 : f32
    }
    return %alloc : memref<4xf32>
  }
  func.func @scale_into(%arg0: memref<4xf32>, %arg1: f32, %arg2: memref<4xf32>) {
    linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel"]} ins(%arg0 : memref<4xf32>) outs(%arg2 : memref<4xf32>) {
    ^bb0(%in: f32, %out: f32):
      %0 = arith.mulf %in, %arg1 : f32
      linalg.yield %0 : f32
    }
    return
  }
}

