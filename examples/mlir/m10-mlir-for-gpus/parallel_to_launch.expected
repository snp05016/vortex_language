#map = affine_map<(d0)[s0, s1] -> (d0 * s0 + s1)>
module attributes {gpu.container_module} {
  func.func @blend(%arg0: memref<8x16xf32>, %arg1: memref<8x16xf32>, %arg2: memref<8x16xf32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c8 = arith.constant 8 : index
    %c2 = arith.constant 2 : index
    gpu.launch_func  @blend_kernel::@blend_kernel blocks in (%c2, %c2, %c1) threads in (%c4, %c8, %c1)  args(%c4 : index, %c0 : index, %c8 : index, %c1 : index, %c0 : index, %arg0 : memref<8x16xf32>, %arg1 : memref<8x16xf32>, %arg2 : memref<8x16xf32>)
    return
  }
  gpu.module @blend_kernel {
    gpu.func @blend_kernel(%arg0: index, %arg1: index, %arg2: index, %arg3: index, %arg4: index, %arg5: memref<8x16xf32>, %arg6: memref<8x16xf32>, %arg7: memref<8x16xf32>) kernel {
      %0 = gpu.block_id  x
      %1 = gpu.block_id  y
      %2 = gpu.thread_id  x
      %3 = gpu.thread_id  y
      %4 = affine.apply #map(%0)[%arg0, %arg1]
      %5 = affine.apply #map(%1)[%arg2, %arg1]
      %6 = affine.apply #map(%2)[%arg3, %arg4]
      %7 = affine.apply #map(%3)[%arg3, %arg4]
      %8 = arith.addi %6, %4 : index
      %9 = arith.addi %7, %5 : index
      %10 = memref.load %arg5[%8, %9] : memref<8x16xf32>
      %11 = memref.load %arg6[%8, %9] : memref<8x16xf32>
      %12 = arith.addf %10, %11 : f32
      memref.store %12, %arg7[%8, %9] : memref<8x16xf32>
      gpu.return
    }
  }
}

