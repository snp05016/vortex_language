#map = affine_map<(d0) -> (d0 * 4)>
#map1 = affine_map<(d0) -> (d0 * 8)>
module attributes {transform.with_named_sequence} {
  func.func @blend(%arg0: memref<8x16xf32>, %arg1: memref<8x16xf32>, %arg2: memref<8x16xf32>) {
    %c2 = arith.constant 2 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c4 = arith.constant 4 : index
    gpu.launch blocks(%arg3, %arg4, %arg5) in (%arg9 = %c2, %arg10 = %c2, %arg11 = %c1) threads(%arg6, %arg7, %arg8) in (%arg12 = %c8, %arg13 = %c4, %arg14 = %c1) {
      %0 = gpu.block_id  x
      %1 = gpu.block_id  y
      %2 = affine.apply #map(%1)
      %3 = affine.apply #map1(%0)
      %subview = memref.subview %arg0[%2, %3] [4, 8] [1, 1] : memref<8x16xf32> to memref<4x8xf32, strided<[16, 1], offset: ?>>
      %subview_0 = memref.subview %arg1[%2, %3] [4, 8] [1, 1] : memref<8x16xf32> to memref<4x8xf32, strided<[16, 1], offset: ?>>
      %subview_1 = memref.subview %arg2[%2, %3] [4, 8] [1, 1] : memref<8x16xf32> to memref<4x8xf32, strided<[16, 1], offset: ?>>
      %4 = gpu.thread_id  x
      %5 = gpu.thread_id  y
      %subview_2 = memref.subview %subview[%5, %4] [1, 1] [1, 1] : memref<4x8xf32, strided<[16, 1], offset: ?>> to memref<1x1xf32, strided<[16, 1], offset: ?>>
      %subview_3 = memref.subview %subview_0[%5, %4] [1, 1] [1, 1] : memref<4x8xf32, strided<[16, 1], offset: ?>> to memref<1x1xf32, strided<[16, 1], offset: ?>>
      %subview_4 = memref.subview %subview_1[%5, %4] [1, 1] [1, 1] : memref<4x8xf32, strided<[16, 1], offset: ?>> to memref<1x1xf32, strided<[16, 1], offset: ?>>
      linalg.add ins(%subview_2, %subview_3 : memref<1x1xf32, strided<[16, 1], offset: ?>>, memref<1x1xf32, strided<[16, 1], offset: ?>>) outs(%subview_4 : memref<1x1xf32, strided<[16, 1], offset: ?>>)
      gpu.barrier
      gpu.terminator
    }
    return
  }
  transform.named_sequence @__transform_main(%arg0: !transform.any_op {transform.readonly}) {
    %0 = transform.structured.match ops{["linalg.add"]} in %arg0 : (!transform.any_op) -> !transform.any_op
    %tiled_op, %forall_op = transform.structured.tile_using_forall %0 tile_sizes [4, 8](mapping = [#gpu.block<y>, #gpu.block<x>]) : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %tiled_op_0, %forall_op_1 = transform.structured.tile_using_forall %tiled_op tile_sizes [1, 1](mapping = [#gpu.thread<y>, #gpu.thread<x>]) : (!transform.any_op) -> (!transform.any_op, !transform.any_op)
    %1 = transform.structured.match ops{["func.func"]} in %arg0 : (!transform.any_op) -> !transform.any_op
    %2 = transform.gpu.map_forall_to_blocks %1 generate_gpu_launch : (!transform.any_op) -> !transform.any_op
    %3 = transform.gpu.map_nested_forall_to_threads %2 block_dims = [8, 4, 1] : (!transform.any_op) -> !transform.any_op
    transform.yield 
  }
}

