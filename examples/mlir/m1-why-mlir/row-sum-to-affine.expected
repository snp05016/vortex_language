module {
  func.func @row_sum(%arg0: memref<3x4xf32>, %arg1: memref<3xf32>) {
    affine.for %arg2 = 0 to 3 {
      affine.for %arg3 = 0 to 4 {
        %0 = affine.load %arg0[%arg2, %arg3] : memref<3x4xf32>
        %1 = affine.load %arg1[%arg2] : memref<3xf32>
        %2 = arith.addf %1, %0 : f32
        affine.store %2, %arg1[%arg2] : memref<3xf32>
      }
    }
    return
  }
}

