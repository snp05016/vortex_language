    %32 = llvm.load %31 : !llvm.ptr -> f32
    %33 = llvm.fadd %32, %29  : f32
    %34 = llvm.extractvalue %13[1] : !llvm.struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)> 
