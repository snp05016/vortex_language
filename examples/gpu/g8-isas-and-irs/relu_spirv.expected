module attributes {gpu.container_module, spirv.target_env = #spirv.target_env<#spirv.vce<v1.0, [Shader], [SPV_KHR_storage_buffer_storage_class]>, #spirv.resource_limits<>>} {
  spirv.module @__spv__kernels Logical GLSL450 {
    spirv.GlobalVariable @__builtin__LocalInvocationId__ built_in("LocalInvocationId") : !spirv.ptr<vector<3xi32>, Input>
    spirv.GlobalVariable @__builtin__WorkgroupId__ built_in("WorkgroupId") : !spirv.ptr<vector<3xi32>, Input>
    spirv.func @relu(%arg0: !spirv.ptr<!spirv.struct<(!spirv.array<256 x f32, stride=4> [0])>, StorageBuffer> {spirv.interface_var_abi = #spirv.interface_var_abi<(0, 0)>}, %arg1: !spirv.ptr<!spirv.struct<(!spirv.array<256 x f32, stride=4> [0])>, StorageBuffer> {spirv.interface_var_abi = #spirv.interface_var_abi<(0, 1)>}) "None" attributes {spirv.entry_point_abi = #spirv.entry_point_abi<workgroup_size = [64, 1, 1]>, workgroup_attributions = 0 : i64} {
      %__builtin__WorkgroupId___addr = spirv.mlir.addressof @__builtin__WorkgroupId__ : !spirv.ptr<vector<3xi32>, Input>
      %0 = spirv.Load "Input" %__builtin__WorkgroupId___addr : vector<3xi32>
      %1 = spirv.CompositeExtract %0[0 : i32] : vector<3xi32>
      %__builtin__LocalInvocationId___addr = spirv.mlir.addressof @__builtin__LocalInvocationId__ : !spirv.ptr<vector<3xi32>, Input>
      %2 = spirv.Load "Input" %__builtin__LocalInvocationId___addr : vector<3xi32>
      %3 = spirv.CompositeExtract %2[0 : i32] : vector<3xi32>
      %cst64_i32 = spirv.Constant 64 : i32
      %4 = spirv.IMul %1, %cst64_i32 : i32
      %5 = spirv.IAdd %4, %3 : i32
      %cst0_i32 = spirv.Constant 0 : i32
      %cst0_i32_0 = spirv.Constant 0 : i32
      %cst1_i32 = spirv.Constant 1 : i32
      %6 = spirv.IMul %cst1_i32, %5 : i32
      %7 = spirv.IAdd %cst0_i32_0, %6 : i32
      %8 = spirv.AccessChain %arg0[%cst0_i32, %7] : !spirv.ptr<!spirv.struct<(!spirv.array<256 x f32, stride=4> [0])>, StorageBuffer>, i32, i32
      %9 = spirv.Load "StorageBuffer" %8 : f32
      %cst_f32 = spirv.Constant 0.000000e+00 : f32
      %10 = spirv.FOrdGreaterThan %9, %cst_f32 : f32
      %11 = spirv.Variable : !spirv.ptr<f32, Function>
      spirv.mlir.selection {
        spirv.BranchConditional %10, ^bb1, ^bb2
      ^bb1:  // pred: ^bb0
        spirv.Store "Function" %11, %9 : f32
        spirv.Branch ^bb3
      ^bb2:  // pred: ^bb0
        spirv.Store "Function" %11, %cst_f32 : f32
        spirv.Branch ^bb3
      ^bb3:  // 2 preds: ^bb1, ^bb2
        spirv.mlir.merge
      }
      %12 = spirv.Load "Function" %11 : f32
      %cst0_i32_1 = spirv.Constant 0 : i32
      %cst0_i32_2 = spirv.Constant 0 : i32
      %cst1_i32_3 = spirv.Constant 1 : i32
      %13 = spirv.IMul %cst1_i32_3, %5 : i32
      %14 = spirv.IAdd %cst0_i32_2, %13 : i32
      %15 = spirv.AccessChain %arg1[%cst0_i32_1, %14] : !spirv.ptr<!spirv.struct<(!spirv.array<256 x f32, stride=4> [0])>, StorageBuffer>, i32, i32
      spirv.Store "StorageBuffer" %15, %12 : f32
      spirv.Return
    }
  }
  gpu.module @kernels {
    gpu.func @relu(%arg0: memref<256xf32, #spirv.storage_class<StorageBuffer>>, %arg1: memref<256xf32, #spirv.storage_class<StorageBuffer>>) kernel attributes {spirv.entry_point_abi = #spirv.entry_point_abi<workgroup_size = [64, 1, 1]>} {
      %0 = gpu.block_id  x
      %1 = gpu.thread_id  x
      %2 = gpu.block_dim  x
      %3 = arith.muli %0, %2 : index
      %4 = arith.addi %3, %1 : index
      %5 = memref.load %arg0[%4] : memref<256xf32, #spirv.storage_class<StorageBuffer>>
      %cst = arith.constant 0.000000e+00 : f32
      %6 = arith.cmpf ogt, %5, %cst : f32
      %7 = scf.if %6 -> (f32) {
