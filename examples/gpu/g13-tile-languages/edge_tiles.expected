#map = affine_map<(d0) -> (-d0 + 10, 4)>
module attributes {transform.with_named_sequence} {
  func.func @edge(%arg0: memref<10x8xf32>, %arg1: memref<8x10xf32>, %arg2: memref<10x10xf32>) {
    %c0 = arith.constant 0 : index
    %c10 = arith.constant 10 : index
    %c4 = arith.constant 4 : index
    scf.for %arg3 = %c0 to %c10 step %c4 {
      %0 = affine.min #map(%arg3)
      scf.for %arg4 = %c0 to %c10 step %c4 {
        %1 = affine.min #map(%arg4)
        %subview = memref.subview %arg0[%arg3, 0] [%0, 8] [1, 1] : memref<10x8xf32> to memref<?x8xf32, strided<[8, 1], offset: ?>>
        %subview_0 = memref.subview %arg1[0, %arg4] [8, %1] [1, 1] : memref<8x10xf32> to memref<8x?xf32, strided<[10, 1], offset: ?>>
        %subview_1 = memref.subview %arg2[%arg3, %arg4] [%0, %1] [1, 1] : memref<10x10xf32> to memref<?x?xf32, strided<[10, 1], offset: ?>>
        linalg.matmul ins(%subview, %subview_0 : memref<?x8xf32, strided<[8, 1], offset: ?>>, memref<8x?xf32, strided<[10, 1], offset: ?>>) outs(%subview_1 : memref<?x?xf32, strided<[10, 1], offset: ?>>)
      }
    }
    return
  }
  transform.named_sequence @__transform_main(%arg0: !transform.any_op) {
    %0 = transform.structured.match ops{["linalg.matmul"]} in %arg0 : (!transform.any_op) -> !transform.any_op
    %tiled_linalg_op, %loops:2 = transform.structured.tile_using_for %0[4, 4, 0] : (!transform.any_op) -> (!transform.any_op, !transform.any_op, !transform.any_op)
    transform.yield 
  }
}

