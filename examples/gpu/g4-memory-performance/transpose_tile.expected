module attributes {gpu.container_module} {
  gpu.module @kernels {
    gpu.func @transpose(%arg0: memref<64x64xf32>, %arg1: memref<64x64xf32>) workgroup(%arg2 : memref<32x33xf32, #gpu.address_space<workgroup>>) kernel {
      %c32 = arith.constant 32 : index
      %0 = gpu.thread_id  x
      %1 = gpu.thread_id  y
      %2 = gpu.block_id  x
      %3 = gpu.block_id  y
      %4 = arith.muli %3, %c32 : index
      %5 = arith.muli %2, %c32 : index
      %6 = arith.addi %4, %1 : index
      %7 = arith.addi %5, %0 : index
      %8 = memref.load %arg0[%6, %7] : memref<64x64xf32>
      memref.store %8, %arg2[%1, %0] : memref<32x33xf32, #gpu.address_space<workgroup>>
      gpu.barrier
      %9 = memref.load %arg2[%0, %1] : memref<32x33xf32, #gpu.address_space<workgroup>>
      %10 = arith.addi %5, %1 : index
      %11 = arith.addi %4, %0 : index
      memref.store %9, %arg1[%10, %11] : memref<64x64xf32>
      gpu.return
    }
  }
}

