module attributes {gpu.container_module} {
  gpu.module @kernels {
    gpu.func @reverse_block(%arg0: memref<64xf32>, %arg1: memref<64xf32>) workgroup(%arg2 : memref<32xf32, #gpu.address_space<workgroup>>) private(%arg3 : memref<1xf32, #gpu.address_space<private>>) kernel {
      %c0 = arith.constant 0 : index
      %cst = arith.constant 2.000000e+00 : f32
      %c31 = arith.constant 31 : index
      %c32 = arith.constant 32 : index
      %0 = gpu.thread_id  x
      %1 = gpu.block_id  x
      %2 = arith.muli %1, %c32 : index
      %3 = arith.addi %2, %0 : index
      %4 = memref.load %arg0[%3] : memref<64xf32>
      %5 = arith.mulf %4, %cst : f32
      memref.store %5, %arg3[%c0] : memref<1xf32, #gpu.address_space<private>>
      %6 = memref.load %arg3[%c0] : memref<1xf32, #gpu.address_space<private>>
      memref.store %6, %arg2[%0] : memref<32xf32, #gpu.address_space<workgroup>>
      gpu.barrier
      %7 = arith.subi %c31, %0 : index
      %8 = memref.load %arg2[%7] : memref<32xf32, #gpu.address_space<workgroup>>
      memref.store %8, %arg1[%3] : memref<64xf32>
      gpu.return
    }
  }
}

