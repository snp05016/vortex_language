module attributes {gpu.container_module} {
  gpu.module @kernels {
    gpu.func @saxpy(%arg0: f32, %arg1: memref<?xf32>, %arg2: memref<?xf32>) kernel {
      %0 = gpu.block_id  x
      %1 = gpu.block_dim  x
      %2 = gpu.thread_id  x
      %3 = arith.muli %0, %1 : index
      %4 = arith.addi %3, %2 : index
      %5 = memref.load %arg1[%4] : memref<?xf32>
      %6 = memref.load %arg2[%4] : memref<?xf32>
      %7 = arith.mulf %arg0, %5 : f32
      %8 = arith.addf %7, %6 : f32
      memref.store %8, %arg2[%4] : memref<?xf32>
      gpu.return
    }
  }
}

