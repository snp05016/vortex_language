module attributes {gpu.container_module} {
  gpu.module @kernels {
    gpu.func @block_sum(%arg0: memref<64xf32>, %arg1: memref<1xf32>) workgroup(%arg2 : memref<64xf32, #gpu.address_space<workgroup>>) kernel {
      %0 = gpu.thread_id  x
      %1 = memref.load %arg0[%0] : memref<64xf32>
      memref.store %1, %arg2[%0] : memref<64xf32, #gpu.address_space<workgroup>>
      gpu.barrier
      %c32 = arith.constant 32 : index
      %2 = arith.cmpi ult, %0, %c32 : index
      scf.if %2 {
        %3 = arith.addi %0, %c32 : index
        %4 = memref.load %arg2[%0] : memref<64xf32, #gpu.address_space<workgroup>>
        %5 = memref.load %arg2[%3] : memref<64xf32, #gpu.address_space<workgroup>>
        %6 = arith.addf %4, %5 : f32
        %7 = gpu.subgroup_reduce  add %6 : (f32) -> f32
        %c0 = arith.constant 0 : index
        %8 = arith.cmpi eq, %0, %c0 : index
        scf.if %8 {
          memref.store %7, %arg1[%c0] : memref<1xf32>
        }
      }
      gpu.return
    }
  }
}

