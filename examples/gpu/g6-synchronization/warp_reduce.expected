module attributes {gpu.container_module} {
  gpu.module @kernels {
    gpu.func @warp_sum(%arg0: memref<32xf32>, %arg1: memref<1xf32>) kernel {
      %0 = gpu.thread_id  x
      %c32_i32 = arith.constant 32 : i32
      %1 = memref.load %arg0[%0] : memref<32xf32>
      %c16_i32 = arith.constant 16 : i32
      %shuffleResult, %valid = gpu.shuffle  xor %1, %c16_i32, %c32_i32 : f32
      %2 = arith.addf %1, %shuffleResult : f32
      %c8_i32 = arith.constant 8 : i32
      %shuffleResult_0, %valid_1 = gpu.shuffle  xor %2, %c8_i32, %c32_i32 : f32
      %3 = arith.addf %2, %shuffleResult_0 : f32
      %c4_i32 = arith.constant 4 : i32
      %shuffleResult_2, %valid_3 = gpu.shuffle  xor %3, %c4_i32, %c32_i32 : f32
      %4 = arith.addf %3, %shuffleResult_2 : f32
      %c2_i32 = arith.constant 2 : i32
      %shuffleResult_4, %valid_5 = gpu.shuffle  xor %4, %c2_i32, %c32_i32 : f32
      %5 = arith.addf %4, %shuffleResult_4 : f32
      %c1_i32 = arith.constant 1 : i32
      %shuffleResult_6, %valid_7 = gpu.shuffle  xor %5, %c1_i32, %c32_i32 : f32
      %6 = arith.addf %5, %shuffleResult_6 : f32
      %c0 = arith.constant 0 : index
      memref.store %6, %arg1[%c0] : memref<1xf32>
      gpu.return
    }
  }
}

