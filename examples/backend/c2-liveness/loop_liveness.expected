instr  code              pass 1  pass 2  pass 3
    0  s = 0             ab      ab      ab
    1  i = 0             abs     abs     abs
    2  t = load a[i]     abis    abis    abis
    3  s = s + t         bist    abist   abist
    4  i = i + 1         bis     abis    abis
    5  if i < b goto 2   bis     abis    abis
    6  return s          s       s       s
name  interval from liveness  first to last mention
a     [0, 5]                  [2, 2]
i     [1, 5]                  [1, 5]
b     [0, 5]                  [5, 5]
t     [2, 3]                  [2, 3]
s     [0, 6]                  [0, 6]
