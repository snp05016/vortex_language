; ModuleID = 'scalar_epilogue.ll'
source_filename = "scalar_epilogue.ll"

define void @axpy17(ptr noalias %y, ptr noalias readonly %x, float %a) {
entry:
  br i1 false, label %scalar.ph, label %vector.ph

vector.ph:                                        ; preds = %entry
  %broadcast.splatinsert = insertelement <4 x float> poison, float %a, i64 0
  %broadcast.splat = shufflevector <4 x float> %broadcast.splatinsert, <4 x float> poison, <4 x i32> zeroinitializer
  br label %vector.body

vector.body:                                      ; preds = %vector.body, %vector.ph
  %index = phi i64 [ 0, %vector.ph ], [ %index.next, %vector.body ]
  %0 = add i64 %index, 0
  %1 = getelementptr inbounds float, ptr %x, i64 %0
  %2 = getelementptr inbounds float, ptr %1, i32 0
  %wide.load = load <4 x float>, ptr %2, align 4
  %3 = getelementptr inbounds float, ptr %y, i64 %0
  %4 = getelementptr inbounds float, ptr %3, i32 0
  %wide.load1 = load <4 x float>, ptr %4, align 4
  %5 = fmul <4 x float> %broadcast.splat, %wide.load
  %6 = fadd <4 x float> %5, %wide.load1
  store <4 x float> %6, ptr %4, align 4
  %index.next = add nuw i64 %index, 4
  %7 = icmp eq i64 %index.next, 16
  br i1 %7, label %middle.block, label %vector.body, !llvm.loop !0

middle.block:                                     ; preds = %vector.body
  br i1 false, label %exit, label %scalar.ph

scalar.ph:                                        ; preds = %entry, %middle.block
  %bc.resume.val = phi i64 [ 16, %middle.block ], [ 0, %entry ]
  br label %loop

loop:                                             ; preds = %loop, %scalar.ph
  %i = phi i64 [ %bc.resume.val, %scalar.ph ], [ %i.next, %loop ]
  %xp = getelementptr inbounds float, ptr %x, i64 %i
  %xv = load float, ptr %xp, align 4
  %yp = getelementptr inbounds float, ptr %y, i64 %i
  %yv = load float, ptr %yp, align 4
  %mul = fmul float %a, %xv
  %add = fadd float %mul, %yv
  store float %add, ptr %yp, align 4
  %i.next = add nuw nsw i64 %i, 1
  %cond = icmp eq i64 %i.next, 17
  br i1 %cond, label %exit, label %loop, !llvm.loop !3

exit:                                             ; preds = %middle.block, %loop
  ret void
}

!0 = distinct !{!0, !1, !2}
!1 = !{!"llvm.loop.isvectorized", i32 1}
!2 = !{!"llvm.loop.unroll.runtime.disable"}
!3 = distinct !{!3, !2, !1}
