theta0 (row-major):
  (0, 0) -> time (0, 0)
  (1, 0) -> time (1, 0)
  (1, 1) -> time (1, 1)
  (2, 0) -> time (2, 0)
  (2, 1) -> time (2, 1)
  (2, 2) -> time (2, 2)
  (3, 0) -> time (3, 0)
  (3, 1) -> time (3, 1)
  (3, 2) -> time (3, 2)
  (3, 3) -> time (3, 3)
  (4, 0) -> time (4, 0)
  (4, 1) -> time (4, 1)
  (4, 2) -> time (4, 2)
  (4, 3) -> time (4, 3)
  (4, 4) -> time (4, 4)
theta1 (skewed by i + j):
  (0, 0) -> time (0, 0)
  (1, 0) -> time (1, 0)
  (2, 0) -> time (2, 0)
  (1, 1) -> time (2, 1)
  (3, 0) -> time (3, 0)
  (2, 1) -> time (3, 1)
  (4, 0) -> time (4, 0)
  (3, 1) -> time (4, 1)
  (2, 2) -> time (4, 2)
  (4, 1) -> time (5, 1)
  (3, 2) -> time (5, 2)
  (4, 2) -> time (6, 2)
  (3, 3) -> time (6, 3)
  (4, 3) -> time (7, 3)
  (4, 4) -> time (8, 4)
