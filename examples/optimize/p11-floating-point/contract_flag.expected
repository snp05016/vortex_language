; ModuleID = 'contract_flag.ll'
source_filename = "contract_flag.ll"

define float @strict(float %a, float %b, float %c) {
  %p = fmul float %a, %b
  %s = fadd float %p, %c
  ret float %s
}

define float @contracted(float %a, float %b, float %c) {
  %p = fmul float %a, %b
  %s = fadd contract float %p, %c
  ret float %s
}
