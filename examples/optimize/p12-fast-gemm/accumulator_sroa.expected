; ModuleID = 'accumulator_sroa.ll'
source_filename = "accumulator_sroa.ll"

define void @row4(float %a0, float %a1, float %a2, float %a3, float %b0, float %b1, ptr %out0, ptr %out1, ptr %out2, ptr %out3) {
entry:
  %t0.0 = fmul float %a0, %b0
  %s0.0 = fadd float 0.000000e+00, %t0.0
  %t1.0 = fmul float %a1, %b0
  %s1.0 = fadd float 0.000000e+00, %t1.0
  %t2.0 = fmul float %a2, %b0
  %s2.0 = fadd float 0.000000e+00, %t2.0
  %t3.0 = fmul float %a3, %b0
  %s3.0 = fadd float 0.000000e+00, %t3.0
  %t0.1 = fmul float %a0, %b1
  %s0.1 = fadd float %s0.0, %t0.1
  %t1.1 = fmul float %a1, %b1
  %s1.1 = fadd float %s1.0, %t1.1
  %t2.1 = fmul float %a2, %b1
  %s2.1 = fadd float %s2.0, %t2.1
  %t3.1 = fmul float %a3, %b1
  %s3.1 = fadd float %s3.0, %t3.1
  store float %s0.1, ptr %out0, align 4
  store float %s1.1, ptr %out1, align 4
  store float %s2.1, ptr %out2, align 4
  store float %s3.1, ptr %out3, align 4
  ret void
}
