; ModuleID = 'ir_flags.ll'
source_filename = "ir_flags.ll"

define i1 @grows(i8 %x) {
  %c = icmp ne i8 %x, 127
  ret i1 %c
}

define i1 @grows_nsw(i8 %x) {
  ret i1 true
}

define float @plus_zero(float %x) {
  %r = fadd float %x, 0.000000e+00
  ret float %r
}

define float @plus_minus_zero(float %x) {
  ret float %x
}

define float @plus_zero_nsz(float %x) {
  ret float %x
}

define float @half(float %x) {
  %r = fmul float %x, 5.000000e-01
  ret float %r
}

define float @tenth(float %x) {
  %r = fdiv float %x, 1.000000e+01
  ret float %r
}

define float @tenth_arcp(float %x) {
  %r = fmul arcp float %x, 0x3FB99999A0000000
  ret float %r
}
