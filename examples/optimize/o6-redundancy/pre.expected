; ModuleID = 'pre.ll'
source_filename = "pre.ll"

declare void @use(i32)

define i32 @diamond(i1 %c, i32 %a, i32 %b) {
entry:
  br i1 %c, label %left, label %entry.join_crit_edge

entry.join_crit_edge:                             ; preds = %entry
  %.pre = add i32 %a, %b
  br label %join

left:                                             ; preds = %entry
  %x = add i32 %a, %b
  call void @use(i32 %x)
  br label %join

join:                                             ; preds = %entry.join_crit_edge, %left
  %y.pre-phi = phi i32 [ %.pre, %entry.join_crit_edge ], [ %x, %left ]
  ret i32 %y.pre-phi
}
