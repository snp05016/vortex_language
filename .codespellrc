# codespell flags known misspellings only, so project jargon needs no word list.
# Run from the repo root (CI does the same):
#   codespell docs includes examples tools/docs mkdocs.yml
[codespell]
# Build output and generated or binary files.
skip = ./site,./build,*.svg,*.woff2,*.pyc,*.egg-info
# Correct words that codespell's dictionary lists as misspellings:
#   resutl  deliberate typo in the name-resolution example (compiler/guide/index.md)
#   wirth   Niklaus Wirth, cited in the reading list
#   fallin  Chris Fallin, author of Cranelift's register allocator
#   olt     MLIR's "ordered less than" float comparison predicate
#   sme     Arm's Scalable Matrix Extension
#   valu    AMD's vector arithmetic logic unit, quoted from a HIP section title
#   advertis  part of the URL of David Salomon's "Assemblers and Loaders"
ignore-words-list = resutl,wirth,fallin,olt,sme,valu,advertis
